<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - XoshBank</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @{
        var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
    }

    @if (!isHome)
    {
        <div class="sidebar">

            <div class="logo">
                XB
            </div>

            <div class="menu">

                <a class="menu-btn" asp-controller="Home" asp-action="Index">
                    <span class="menu-icon">🏠</span>
                    <span>Dashboard</span>
                </a>

                <a class="menu-btn" asp-controller="Customers" asp-action="Index">
                    <span class="menu-icon">👤</span>
                    <span>Customers</span>
                </a>

                <a class="menu-btn" asp-controller="Accounts" asp-action="Index">
                    <span class="menu-icon">💳</span>
                    <span>Accounts</span>
                </a>

                <a class="menu-btn" asp-controller="Cards" asp-action="Index">
                    <span class="menu-icon">🪪</span>
                    <span>Cards</span>
                </a>

                <a class="menu-btn" asp-controller="Loans" asp-action="Index">
                    <span class="menu-icon">💰</span>
                    <span>Loans</span>
                </a>

                <a class="menu-btn" asp-controller="Employees" asp-action="Index">
                    <span class="menu-icon">👥</span>
                    <span>Employees</span>
                </a>

                <a class="menu-btn" asp-controller="Branches" asp-action="Index">
                    <span class="menu-icon">🏦</span>
                    <span>Branches</span>
                </a>

            </div>

        </div>
    }

    <div class="@(isHome ? "home-main" : "main")">

        <div class="page-content">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>