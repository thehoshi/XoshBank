@{
    ViewData["Title"] = "Dashboard";
}

<div class="home-dashboard">

    <div class="dashboard-header">
        <h1>XoshBank</h1>
        <p>Bank Management System</p>
    </div>

    <div class="cards">

        <a asp-controller="Customers" asp-action="Index" class="dashboard-card">
            <div class="card-icon">👤</div>
            <h3>Customers</h3>
            <p>Manage bank customers</p>
        </a>

        <a asp-controller="Accounts" asp-action="Index" class="dashboard-card">
            <div class="card-icon">💳</div>
            <h3>Accounts</h3>
            <p>Manage customer accounts</p>
        </a>

        <a asp-controller="Cards" asp-action="Index" class="dashboard-card">
            <div class="card-icon">🪪</div>
            <h3>Cards</h3>
            <p>Manage bank cards</p>
        </a>

        <a asp-controller="Loans" asp-action="Index" class="dashboard-card">
            <div class="card-icon">💰</div>
            <h3>Loans</h3>
            <p>Manage loans and payments</p>
        </a>

        <a asp-controller="Employees" asp-action="Index" class="dashboard-card">
            <div class="card-icon">👥</div>
            <h3>Employees</h3>
            <p>Manage employees</p>
        </a>

        <a asp-controller="Branches" asp-action="Index" class="dashboard-card">
            <div class="card-icon">🏦</div>
            <h3>Branches</h3>
            <p>Manage bank branches</p>
        </a>

    </div>

</div>