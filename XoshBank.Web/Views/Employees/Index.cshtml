@model XoshBank.Web.Models.EmployeeUiModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employees List</h2>
    <a asp-controller="Employees" asp-action="Create" class="btn btn-primary">Add Employee</a>
</div>

<p>Manage all employees in the system</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>No</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Position</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model.Employees)
        {
            <tr>
                <td>@emp.No</td>
                <td>@emp.FirstName</td>
                <td>@emp.LastName</td>
                <td>@emp.Email</td>
                <td>@emp.Position</td>
            </tr>
        }
    </tbody>
</table>
