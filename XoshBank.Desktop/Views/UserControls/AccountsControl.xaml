<UserControl x:Class="XoshBank.Desktop.Views.UserControls.AccountsControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XoshBank.Desktop.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="397*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Margin="28,28,22,28" Padding="20" CornerRadius="28" Background="#F8F0F6" Effect="{StaticResource CardShadow}">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="14,12"
                        Margin="0,0,14,14"
                        Effect="{StaticResource SoftShadow}">

                    <Grid Style="{StaticResource GrdForm}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3"
                                   Text="Account details"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#352439"
                                   Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Customer ID"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentAccount.CustomerID, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Account Number"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentAccount.AccountNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Balance"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentAccount.Balance, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Account Type"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentAccount.AccountType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Currency"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentAccount.Currency, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                        Background="#FFFDF9FC"
                        CornerRadius="18"
                        Padding="12"
                        Effect="{StaticResource SoftShadow}">

                    <StackPanel>
                        <TextBlock Text="Actions"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#352439"
                                   Margin="4,2,4,10"/>

                        <Button Command="{Binding AddCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="4">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="7">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding CurrentState}" Value="3">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Add
                        </Button>
                        <Button Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="4">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="7">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Save
                        </Button>
                        <Button Command="{Binding EditCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="3">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Edit
                        </Button>
                        <Button Command="{Binding RejectCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Reject
                        </Button>
                        <Button Command="{Binding DeleteCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="3">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Delete
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="14,10"
                        Margin="0,0,14,14"
                        Effect="{StaticResource SoftShadow}">

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Search"
                                   FontSize="14"
                                   Foreground="#5A4860"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox DockPanel.Dock="Left"
                                 Width="280"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding SearchValue, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button DockPanel.Dock="Right"
                                Width="110"
                                Height="34"
                                Content="Export"
                                Command="{Binding ExportCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="8"
                        Margin="0,0,14,0"
                        Effect="{StaticResource SoftShadow}">

                    <DataGrid ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No"              Binding="{Binding No}" Width="*"/>
                            <DataGridTextColumn Header="Customer ID"     Binding="{Binding CustomerID}" Width="*"/>
                            <DataGridTextColumn Header="Account Number"  Binding="{Binding AccountNumber}" Width="*"/>
                            <DataGridTextColumn Header="Balance"         Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="*"/>
                            <DataGridTextColumn Header="Type"            Binding="{Binding AccountType}" Width="*"/>
                            <DataGridTextColumn Header="Currency"        Binding="{Binding Currency}" Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
