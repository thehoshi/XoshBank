<UserControl x:Class="XoshBank.Views.UserControls.ATMLocationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XoshBank.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource AppBackground}">
        <Border Margin="28" Padding="20" CornerRadius="28" Background="#F8F0F6" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

               
                <Border Grid.Row="1" Grid.Column="0"
                    Background="White" CornerRadius="18"
                    Padding="14,12" Margin="0,0,14,14"
                    Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3"
                               Text="ATM Location details"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#352439"
                               Margin="0,0,8,10"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Name"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentATMLocation.Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="City"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentATMLocation.City, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Address"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentATMLocation.Address, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Latitude"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentATMLocation.Latitude, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Longitude"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentATMLocation.Longitude, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                
                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                    Background="#FFFDF9FC" CornerRadius="18"
                    Padding="12" Effect="{StaticResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold"
                               Foreground="#352439" Margin="4,2,4,10"/>
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="Add"    Command="{Binding AddATMLocationCommand}"   IsEnabled="{Binding IsAddEnabled}"/>
                        <Button Style="{StaticResource ActionButtonStyle}"        Content="Save"   Command="{Binding SaveATMLocationCommand}"    IsEnabled="{Binding IsSaveRejectEnabled}"/>
                        <Button Style="{StaticResource ActionButtonStyle}"        Content="Edit"   Command="{Binding EditATMLocationCommand}"    IsEnabled="{Binding IsEditDeleteEnabled}"/>
                        <Button Style="{StaticResource ActionButtonStyle}"        Content="Reject" Command="{Binding RejectATMLocationCommand}"  IsEnabled="{Binding IsSaveRejectEnabled}"/>
                        <Button Style="{StaticResource DangerActionButtonStyle}"  Content="Delete" Command="{Binding DeleteATMLocationCommand}"   IsEnabled="{Binding IsEditDeleteEnabled}"/>
                    </StackPanel>
                </Border>

                
                <Border Grid.Row="2" Grid.Column="0"
                    Background="White" CornerRadius="18"
                    Padding="14,10" Margin="0,0,14,14"
                    Effect="{StaticResource SoftShadow}">
                    
                    
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Search"
                               FontSize="14" Foreground="#5A4860"
                               VerticalAlignment="Center"/>
                        <TextBox DockPanel.Dock="Left" Width="200"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="10,0,0,0"
                              VerticalContentAlignment="Center"/>

                        <Button DockPanel.Dock="Right" Width="110" Height="34"
                            Content="Export" Command="{Binding ExportCommand}"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="Button_Click_1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                
                <Border Grid.Row="3" Grid.Column="0"
                    Background="White" CornerRadius="18"
                    Padding="8" Margin="0,0,14,0"
                    Effect="{StaticResource SoftShadow}">
                    <DataGrid ItemsSource="{Binding Locations}"
                          SelectedItem="{Binding SelectedLocation, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No"      Binding="{Binding No}"        Width="*"/>
                            <DataGridTextColumn Header="Name"    Binding="{Binding Name}"      Width="*"/>
                            <DataGridTextColumn Header="City"    Binding="{Binding City}"      Width="*"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}"   Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
