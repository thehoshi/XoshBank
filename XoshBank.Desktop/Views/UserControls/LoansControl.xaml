<UserControl x:Class="XoshBank.Desktop.Views.UserControls.LoansControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:XoshBank.Desktop.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="8" Opacity="0.16" Color="#8E4A74"/>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="4" Opacity="0.12" Color="#8E4A74"/>

        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFDF8FB" Offset="0"/>
            <GradientStop Color="#FFF9EDF4" Offset="0.45"/>
            <GradientStop Color="#FFF3DDEB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF4D8D" Offset="0"/>
            <GradientStop Color="#FFDD5BA3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF6B6B" Offset="0"/>
            <GradientStop Color="#FFFF4D4F" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#2E2130"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#E9D8E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E14E90"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF4D4F"/>
            <Setter Property="BorderBrush" Value="#FF4D4F"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A4860"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#FAF7FB"/>
            <Setter Property="BorderBrush" Value="#E7D8E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2E2130"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyTextStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Background" Value="#FFF6F2F7"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#FAF7FB"/>
            <Setter Property="BorderBrush" Value="#E7D8E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2E2130"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF9F2F7"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF6ECF4"/>
            <Setter Property="Foreground" Value="#4A3250"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EADAE5"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#3A2B40"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Border Margin="28" Padding="20" CornerRadius="28" Background="#F8F0F6" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFFFF" CornerRadius="18" Padding="14,12" Margin="0,0,14,14" Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="4" Text="Loan details" FontSize="14" FontWeight="SemiBold" Foreground="#352439" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="No"/>
                            <TextBox Style="{StaticResource ReadOnlyTextStyle}" Text="{Binding CurrentLoan.No}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Customer ID"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.CustomerID, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Approved by"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.ApprovedBy, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Branch ID"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.BranchID, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Amount"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.Amount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Interest rate"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.InterestRate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Total amount"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.TotalAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Monthly payment"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.MonthlyPayment, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Status"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.Status, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Loan type"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.LoanType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Currency"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.Currency, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Start date"/>
                            <DatePicker Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding CurrentLoan.StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="End date"/>
                            <DatePicker Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding CurrentLoan.EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Approval date"/>
                            <DatePicker Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding CurrentLoan.ApprovalDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Duration (months)"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.DurationMonths, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Collateral"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.Collateral, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Notes"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding CurrentLoan.Notes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Background="#FFFDF9FC" CornerRadius="18" Padding="12" Margin="0,0,0,0" Effect="{StaticResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold" Foreground="#352439" Margin="4,2,4,10"/>
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="Add" Command="{Binding AddCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Save" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Edit" Command="{Binding EditCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Reject" Command="{Binding RejectCommand}"/>
                        <Button Style="{StaticResource DangerActionButtonStyle}" Content="Delete" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Background="#FFFFFFFF" CornerRadius="18" Padding="14,10" Margin="0,0,14,14" Effect="{StaticResource SoftShadow}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="14" Foreground="#5A4860" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox DockPanel.Dock="Left" Width="280" Style="{StaticResource InputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button DockPanel.Dock="Right" Width="110" Height="34" Content="Export" Command="{Binding ExportCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Grid.Column="0" Background="#FFFFFFFF" CornerRadius="18" Padding="8" Margin="0,0,14,0" Effect="{StaticResource SoftShadow}">
                    <DataGrid ItemsSource="{Binding Loans}"
                              SelectedItem="{Binding SelectedLoan, Mode=TwoWay}"
                              RowStyle="{x:Null}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No"              Binding="{Binding No}" Width="60"/>
                            <DataGridTextColumn Header="Customer ID"     Binding="{Binding CustomerID}" Width="95"/>
                            <DataGridTextColumn Header="Approved By"     Binding="{Binding ApprovedBy}" Width="120"/>
                            <DataGridTextColumn Header="Branch ID"       Binding="{Binding BranchID}" Width="80"/>
                            <DataGridTextColumn Header="Amount"          Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Interest Rate"   Binding="{Binding InterestRate, StringFormat={}{0:N2}}" Width="105"/>
                            <DataGridTextColumn Header="Total Amount"    Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Monthly Payment" Binding="{Binding MonthlyPayment, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="Status"          Binding="{Binding Status}" Width="95"/>
                            <DataGridTextColumn Header="Loan Type"       Binding="{Binding LoanType}" Width="100"/>
                            <DataGridTextColumn Header="Currency"        Binding="{Binding Currency}" Width="80"/>
                            <DataGridTextColumn Header="Start Date"       Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="End Date"         Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Approval Date"    Binding="{Binding ApprovalDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Duration Months"  Binding="{Binding DurationMonths}" Width="110"/>
                            <DataGridTextColumn Header="Collateral"      Binding="{Binding Collateral}" Width="140"/>
                            <DataGridTextColumn Header="Notes"           Binding="{Binding Notes}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>