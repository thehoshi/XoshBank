 <UserControl
    x:Class="XoshBank.Desktop.Views.UserControls.CardsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="807"
    d:DesignWidth="1107">

    <Grid Background="{StaticResource AppBackground}">

        <Border Margin="28"
                Padding="20"
                CornerRadius="28"
                Background="#F8F0F6"
                Effect="{StaticResource CardShadow}">

            <Grid>

              
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

               
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

               

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="14,12"
                        Margin="0,0,14,14"
                        Effect="{StaticResource SoftShadow}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        
                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="3"
                                   Text="Card Details"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#352439"
                                   Margin="0,0,0,10" />

                        
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,8,8">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Card Number" />

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding CurrentCard.CardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,8,8">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Card Type" />

                            <ComboBox Style="{StaticResource ComboBoxStyle}"
                                      ItemsSource="{Binding CardTypes}"
                                      SelectedItem="{Binding CurrentCard.CardType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" />
                        </StackPanel>

                        
                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0,0,8,8">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Expiry Date" />

                            <DatePicker Style="{StaticResource DatePickerStyle}"
                                        SelectedDate="{Binding CurrentCard.ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,8,8">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="CVV" />

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding CurrentCard.CVV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,8,8">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Balance" />

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding CurrentCard.Balance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                       
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="0,0,8,8">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Account" />

                            <ComboBox Style="{StaticResource ComboBoxStyle}"
                                      ItemsSource="{Binding Accounts}"
                                      DisplayMemberPath="AccountNumber"
                                      SelectedValuePath="AccountId"
                                      SelectedValue="{Binding CurrentCard.AccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" />
                        </StackPanel>

                    </Grid>
                </Border>

                

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        Background="#FFFDF9FC"
                        CornerRadius="18"
                        Padding="12"
                        Effect="{StaticResource SoftShadow}">

                    <StackPanel>

                        <TextBlock Text="Actions"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#352439"
                                   Margin="4,2,4,10" />

                        <StackPanel>
                            <Button Command="{Binding AddCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Add">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                Add
                            </Button>


                            <Button Command="{Binding SaveCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Default">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                Save
                            </Button>


                            <Button Command="{Binding RejectCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Default">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                Reject
                            </Button>


                            <Button Command="{Binding DeleteCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Default">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                Delete
                            </Button>


                            <Button Command="{Binding EditCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Selected">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Default">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                Edit
                            </Button>
                        </StackPanel>


                    </StackPanel>
                </Border>

              
                <Border Grid.Row="2"
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="14,10"
                        Margin="0,0,14,14"
                        Effect="{StaticResource SoftShadow}">

                    <DockPanel LastChildFill="False">

                        <TextBlock DockPanel.Dock="Left"
                                   Text="Search"
                                   FontSize="14"
                                   Foreground="#5A4860"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <TextBox DockPanel.Dock="Left"
                                 Width="280"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding SearchValue, UpdateSourceTrigger=PropertyChanged}" />

                        <Button DockPanel.Dock="Right"
                                Width="110"
                                Height="34"
                                Content="Export"
                                Command="{Binding ExportCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand" />

                    </DockPanel>
                </Border>

               
                <Border Grid.Row="3"
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="2"
                        Margin="0,0,14,0"
                        Effect="{StaticResource SoftShadow}">

                    <DataGrid ItemsSource="{Binding Cards}"
                              SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Card ID"
                                                Binding="{Binding CardId}"
                                                Width="70" />

                            <DataGridTextColumn Header="Card Number"
                                                Binding="{Binding CardNumber}"
                                                Width="140" />

                            <DataGridTextColumn Header="Card Type"
                                                Binding="{Binding CardType}"
                                                Width="100" />

                            <DataGridTextColumn Header="Expiry Date"
                                                Binding="{Binding ExpiryDate, StringFormat={}{0:MM/yyyy}}"
                                                Width="100" />

                            <DataGridTextColumn Header="CVV"
                                                Binding="{Binding CVV}"
                                                Width="70" />

                            <DataGridTextColumn Header="Balance"
                                                Binding="{Binding Balance, StringFormat={}{0:N2}}"
                                                Width="100" />

                            <DataGridTextColumn Header="Account Id"
                                                Binding="{Binding AccountId}"
                                                Width="100" />

                            <DataGridTextColumn Header="Created Date"
                                                Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                Width="120" />

                            <DataGridTextColumn Header="Deleted At"
                                                Binding="{Binding DeletedAt, StringFormat={}{0:dd.MM.yyyy}}"
                                                Width="120" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
