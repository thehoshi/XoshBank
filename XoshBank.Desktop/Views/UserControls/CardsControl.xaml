<UserControl 
    x:Class="XoshBank.Desktop.Views.UserControls.CardsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    d:DesignHeight="807.2" d:DesignWidth="1107.2">

    <Grid Background="{StaticResource AppBackground}">
        <Border Margin="28" Padding="20" CornerRadius="28" Background="#F8F0F6" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

               
                <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="18" Padding="14,12" Margin="0,0,14,14" Effect="{StaticResource SoftShadow}">
                    <Grid>
                       
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            
                            <RowDefinition Height="Auto"/>
                           
                            <RowDefinition Height="Auto"/>
                           
                        </Grid.RowDefinitions>

                        
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" 
                                   Text="Card details" 
                                   FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#352439" Margin="0,0,0,10"/>

                        
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Card Number"/>
                            <TextBox Style="{StaticResource InputStyle}" 
                                     Text="{Binding CurrentCard.CardNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Card Type"/>
                            <TextBox Style="{StaticResource InputStyle}" 
                                     Text="{Binding CurrentCard.CardType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Expiry Date"/>
                            <DatePicker Style="{StaticResource DatePickerStyle}" 
                                        SelectedDate="{Binding CurrentCard.ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Text="Select a date"/>
                        </StackPanel>

                       
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="CVV"/>
                            <TextBox Style="{StaticResource InputStyle}" 
                                     Text="{Binding CurrentCard.CVV, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Balance"/>
                            <TextBox Style="{StaticResource InputStyle}" 
                                     Text="{Binding CurrentCard.Balance, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Account Id"/>
                            <TextBox Style="{StaticResource InputStyle}" 
                                     Text="{Binding CurrentCard.AccountId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions -->
                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Background="#FFFDF9FC" CornerRadius="18" Padding="12" Effect="{StaticResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold" Foreground="#352439" Margin="4,2,4,10"/>
                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="Add" Command="{Binding AddCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Save" Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Edit" Command="{Binding EditCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Reject" Command="{Binding RejectCommand}"/>
                        <Button Style="{StaticResource DangerActionButtonStyle}" Content="Delete" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Border>
                <!-- Actions -->
                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Background="#FFFDF9FC" CornerRadius="18" Padding="12" Effect="{StaticResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold" Foreground="#352439" Margin="4,2,4,10"/>

                        <!-- Add -->
                        <Button Command="{Binding AddCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="3">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="4">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Add
                        </Button>

                        <!-- Save -->
                        <Button Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="4">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Save
                        </Button>

                        <!-- Edit -->
                        <Button Command="{Binding EditCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="2">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="3">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Edit
                        </Button>

                        <!-- Reject -->
                        <Button Command="{Binding RejectCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Reject
                        </Button>

                        <!-- Delete -->
                        <Button Command="{Binding DeleteCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="1">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="2">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="3">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Delete
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="18" Padding="14,10" Margin="0,0,14,14" Effect="{StaticResource SoftShadow}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontSize="14" Foreground="#5A4860" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox DockPanel.Dock="Left" Width="280" Style="{StaticResource InputStyle}" Text="{Binding SearchValue, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button DockPanel.Dock="Right" Width="110" Height="34" Content="Export" Command="{Binding ExportCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                    </DockPanel>
                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="3" Grid.Column="0" Background="White" CornerRadius="18" Padding="2" Margin="0,0,14,0" Effect="{StaticResource SoftShadow}">
                    <DataGrid ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Card ID" Binding="{Binding CardId}" Width="70"/>
                            <DataGridTextColumn Header="Card Number" Binding="{Binding CardNumber}" Width="120"/>
                            <DataGridTextColumn Header="Card Type" Binding="{Binding CardType}" Width="100"/>
                            <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:MM/yyyy}}" Width="80"/>
                            <DataGridTextColumn Header="CVV" Binding="{Binding CVV}" Width="60"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="80"/>
                            <DataGridTextColumn Header="Account Id" Binding="{Binding AccountId}" Width="100"/>
                            <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Deleted At" Binding="{Binding DeletedAt, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
