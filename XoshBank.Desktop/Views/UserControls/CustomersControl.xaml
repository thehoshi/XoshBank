<UserControl x:Class="XoshBank.Desktop.Views.UserControls.CustomersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XoshBank.Desktop.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <Grid Background="{StaticResource AppBackground}">

        <Border Margin="28" Padding="20" CornerRadius="28" Background="#F8F0F6" Effect="{StaticResource CardShadow}">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="1" Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="14,12"
                        Margin="0,0,14,14"
                        Effect="{StaticResource SoftShadow}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3"
                                   Text="Customer details"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#352439"
                                   Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="First Name"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SelectedCustomer.FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Last Name"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SelectedCustomer.LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Date of Birth"/>
                            <DatePicker Style="{StaticResource DatePickerStyle}"
                                        SelectedDate="{Binding SelectedCustomer.DateOfBirth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Phone"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SelectedCustomer.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Email"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SelectedCustomer.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Address"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SelectedCustomer.Address, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,8,8,0">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="FIN Code"/>
                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding SelectedCustomer.FINCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                    </Grid>
                </Border>

                
                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                        Background="#FFFDF9FC"
                        CornerRadius="18"
                        Padding="12"
                        Effect="{StaticResource SoftShadow}">

                    <StackPanel>
                        <TextBlock Text="Actions"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#352439"
                                   Margin="4,2,4,10"/>

                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Content="Add"    Command="{Binding AddCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}"        Content="Save"   Command="{Binding SaveCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}"        Content="Edit"   Command="{Binding EditCommand}"/>
                        <Button Style="{StaticResource ActionButtonStyle}"        Content="Reject" Command="{Binding RejectCommand}"/>
                        <Button Style="{StaticResource DangerActionButtonStyle}"  Content="Delete" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Grid.Row="2" Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="14,10"
                        Margin="0,0,14,14"
                        Effect="{StaticResource SoftShadow}">

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Search"
                                   FontSize="14"
                                   Foreground="#5A4860"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox DockPanel.Dock="Left"
                                 Width="280"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding SearchValue, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button DockPanel.Dock="Right"
                                Width="110"
                                Height="34"
                                Content="Export"
                                Command="{Binding ExportCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                
                <Border Grid.Row="3" Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="8"
                        Margin="0,0,10,0"
                        Effect="{StaticResource SoftShadow}">
     
                        <DataGrid
                        ItemsSource="{Binding Customers}"
                        SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" SelectionChanged="DataGrid_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No"          Binding="{Binding No}" Width="Auto"/>
                                <DataGridTextColumn Header="First Name"  Binding="{Binding FirstName}" Width="*"/>
                                <DataGridTextColumn Header="Last Name"   Binding="{Binding LastName}" Width="*"/>
                                <DataGridTextColumn Header="Birth Date"  Binding="{Binding DateOfBirth, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                                <DataGridTextColumn Header="Phone"       Binding="{Binding PhoneNumber}" Width="*"/>
                                <DataGridTextColumn Header="Email"       Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="FIN"         Binding="{Binding FINCode}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>
                </Border>

            </Grid>
        </Border>

    </Grid>
    </UserControl>

